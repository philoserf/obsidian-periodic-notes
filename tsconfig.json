{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "include": ["src/**/*", "deploy.ts", "version-bump.ts"],
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "ESNext"],
    "module": "ESNext",
    "types": ["svelte", "node", "bun"],
    "noEmit": true,
    "paths": { "src/*": ["./src/*"] }
  }
}
