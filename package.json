{
  "name": "periodic-notes",
  "version": "2.6.0",
  "description": "Create and manage daily, weekly, monthly, and yearly notes",
  "main": "main.js",
  "author": "Mark Ayers (originally by Liam Cain)",
  "license": "MIT",
  "scripts": {
    "audit": "bun audit --audit-level=critical",
    "dev": "vite build --watch",
    "build": "bun run check && vite build",
    "check": "bun run typecheck && biome check . && svelte-check --tsgo && prettier --check \"**/*.md\"",
    "typecheck": "bun --check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write . && prettier --write \"**/*.md\"",
    "format:check": "biome format .",
    "version": "bun run version-bump.ts",
    "test": "bun test",
    "deploy": "bun run build && bun run deploy.ts"
  },
  "overrides": {
    "devalue": ">=5.6.4"
  },
  "dependencies": {
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@7",
    "moment": "^2.31.0",
    "obsidian": "^1.14.4",
    "prettier": "^3.9.10",
    "svelte-check": "^4.7.7",
    "vite": "^8.3.4"
  }
}
